{
    "name": "salvocortesiano/aireply",
    "type": "phpbb-extension",
    "description": "Risposte automatiche generate da IA (OpenAI / Google Gemini) nei forum selezionati.",
    "homepage": "https://github.com/salvocortesiano/aireply",
    "version": "1.0.8-dev",
    "keywords": [
        "phpbb",
        "extension",
        "ai",
        "openai",
        "chatgpt",
        "gemini",
        "bot"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Salvo Cortesiano",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "phpbb/phpbb": ">=3.3",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "AI Reply",
        "soft-require": {
            "phpbb/phpbb": ">=3.3"
        },
        "version-check": {
            "host": "raw.githubusercontent.com",
            "directory": "/salvocortesiano/aireply/main",
            "filename": "version.json"
        }
    }
}
